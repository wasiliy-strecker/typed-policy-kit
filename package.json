{
  "name": "typed-policy-kit-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe authorization policies shared between React and Node.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "pnpm build:packages && pnpm --filter @typed-policy/team-console dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "pack:check": "turbo run pack:check",
    "test": "turbo run test",
    "test:e2e": "pnpm build:packages && pnpm --filter @typed-policy/team-console test:e2e",
    "test:types": "turbo run test:types",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:types && pnpm build && pnpm pack:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.2",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "supertest": "^7.3.1",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
